# Copy this file to .env and fill in real values for local development.
# Never commit .env — it is gitignored. Production secrets must come from a
# secrets manager, not this file.

APP_ENV=development

# --- HTTP ---
HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
# Matches the postgres service in compose.yaml.
DATABASE_URL=postgres://deeparchive:deeparchive-dev-password@localhost:5432/deeparchive?sslmode=disable
POSTGRES_USER=deeparchive
POSTGRES_PASSWORD=deeparchive-dev-password
POSTGRES_DB=deeparchive

# --- Auth ---
# Generate a real secret for anything beyond local dev, e.g.:
#   openssl rand -base64 48
ACCESS_TOKEN_SIGNING_KEY=replace-with-a-high-entropy-local-dev-secret-min-32-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
SESSION_COOKIE_SECURE=false

# --- Object storage (MinIO locally; any S3-compatible provider in prod) ---
# These are local MinIO root credentials, not permanent credentials handed to
# clients — the API issues short-lived, narrowly scoped presigned URLs
# derived from them. See docs/encryption.md and docs/backup-protocol.md.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=deeparchive-dev
S3_ACCESS_KEY_ID=deeparchive-dev
S3_SECRET_ACCESS_KEY=deeparchive-dev-secret
S3_USE_PATH_STYLE=true

# --- Background jobs (cmd/worker) ---
# How often retention enforcement runs (internal/retention.Service.Sweep).
# Shorten this for local testing if you want to see retention act quickly.
RETENTION_SWEEP_INTERVAL=1h

LOG_LEVEL=info

# --- Email (SMTP) ---
# Optional: leave SMTP_USERNAME/SMTP_PASSWORD blank to keep using the
# dev-only Dev Inbox (http://localhost:5173/dev/inbox) instead of real
# mail. To send real email via Gmail SMTP: SMTP_USERNAME is your full
# Gmail address, SMTP_PASSWORD is a 16-character Gmail App Password
# (Google Account -> Security -> 2-Step Verification -> App Passwords;
# requires 2FA already enabled on that Gmail account), NOT your normal
# Gmail password. SMTP_FROM defaults to SMTP_USERNAME if left blank.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Public URLs ---
# Browser-facing dashboard origin, used for links in emails and the CLI login flow.
WEB_PUBLIC_URL=http://localhost:5173
# Storage address clients can reach, used to presign upload/download URLs (the API itself talks to S3_ENDPOINT).
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Public contact address shown on the Terms of Service and Privacy Policy
# pages (a monitored mailbox, not a personal one). Read at web build time;
# leave blank to omit it from the pages.
VITE_CONTACT_EMAIL=

# Set to "true" only behind a reverse proxy that appends X-Forwarded-For
# (see compose.prod.yaml). Never true when the API is directly reachable.
TRUST_PROXY=false
